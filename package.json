{
  "name": "@tweakcad/mcp-bridge",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "MCP relay between an MCP client over stdio and the running TweakCAD web app over WebSocket. Pure relay — tool execution happens in the browser.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cad",
    "tweakcad"
  ],
  "homepage": "https://github.com/TweakCAD/TweakCAD-MCP#readme",
  "bugs": "https://github.com/TweakCAD/TweakCAD-MCP/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TweakCAD/TweakCAD-MCP.git"
  },
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "tweakcad-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ tests/",
    "start": "node --enable-source-maps dist/cli.js",
    "test:unit": "vitest run",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.4",
    "@types/ws": "8.18.1",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
